DB_ADMIN_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/postgres
DATABASE_URL=postgresql+psycopg://notion_sys_user:password@localhost:5432/notion_db
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LIBRARY_FILES_ROOT=/var/lib/forgelab/
NAS_MOUNT_ROOT=/mnt/forgelab
LOGS_FILES_ROOT=/var/log/forgelab
LOGGING_LEVEL=INFO
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUP_COUNT=5
TEMP_FILES_ROOT=./tmp
FILE_REMOVE_ATTEMPTS=5
FILE_REMOVE_RETRY_SECONDS=0.25
WORKER_NOTIFY_TIMEOUT_SECONDS=30
WORKER_RECONCILE_INTERVAL_SECONDS=60
WORKER_HEARTBEAT_SECONDS=30
WORKER_LEASE_TIMEOUT_SECONDS=300
